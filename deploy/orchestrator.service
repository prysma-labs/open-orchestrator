[Unit]
Description=Open Orchestrator coordinator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=exedev
WorkingDirectory=/home/exedev/orchestrator
EnvironmentFile=/home/exedev/orchestrator.env
ExecStart=/usr/bin/env npm run coordinator
Restart=always
RestartSec=3
# Pi and the worktrees need a normal home directory.
Environment=HOME=/home/exedev

[Install]
WantedBy=multi-user.target
