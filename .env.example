# Copy to .env.local for Vercel, or to the VM env file. Leave blank for local development.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
IP_HASH_SALT=

# rpc uses the Pi CLI. simulated is the local default.
PI_DRIVER=simulated
PI_BIN=pi
PI_MODEL=
SIM_STEP_MS=700
COORDINATOR_ID=
WORK_ROOT=./.data/work
POLL_MS=1000
ALLOW_FAILURE_INJECTION=0
